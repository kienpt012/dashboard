generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  LEADER
  CLERK
  MANAGER
  STAFF
  VIEWER
}

enum TargetStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  OVERDUE
  COMPLETED
}

enum TargetFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum TargetDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum ProgressReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportBatchStatus {
  PREVIEWED
  SUBMITTED
  PARTIALLY_REVIEWED
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  APPLIED
  FAILED
}

enum FeedbackCategory {
  INFRASTRUCTURE
  ENVIRONMENT
  ADMINISTRATIVE_PROCEDURE
  SECURITY_ORDER
  SOCIAL_WELFARE
  CULTURE_EDUCATION
  OTHER
}

enum FeedbackPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FeedbackStatus {
  RECEIVED
  ASSIGNED
  IN_PROGRESS
  WAITING_CITIZEN
  PENDING_REVIEW
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
}

enum FeedbackMessageVisibility {
  INTERNAL
  PUBLIC
}

enum FeedbackClosureReason {
  RESOLVED
  NO_CITIZEN_RESPONSE
  OUT_OF_SCOPE
}

enum MailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD_LETTER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum DocumentType {
  KE_HOACH
  QUYET_DINH
  CONG_VAN
  BAO_CAO
  NGHI_QUYET
  PHU_LUC
  KHAC
}

enum ExtractionJobKind {
  DOCUMENT_PARSE
  INDICATOR_EXTRACT
}

enum ExtractionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
  DEAD_LETTER
}

enum ExtractionMethod {
  RULE_BASED
  LLM
}

enum CandidateKind {
  NEW_INDICATOR
  PROGRESS_UPDATE
}

enum CandidateStatus {
  PROPOSED
  SUBMITTED
  APPROVED
  REJECTED
}

// Đề xuất do AI trích xuất hay do một cán bộ tự phát hiện. Chỉ đề xuất đã có người
// trình (SUBMITTED) mới được tự thông qua khi quá hạn — kết quả AI luôn qua tay người trước.
enum CandidateOrigin {
  AI
  HUMAN
}

enum LocalityKind {
  XA
  PHUONG
  DAC_KHU
  TRUONG_HOC
  CO_QUAN_KHAC
}

enum DepartmentKind {
  LEADERSHIP
  OFFICE
  SPECIALIZED
  CENTER
  OTHER
}

// Loại bộ chỉ tiêu: kế hoạch – thực hiện, chấm điểm, nhiệm vụ, thống kê.
enum FrameworkKind {
  PLAN
  SCORE
  TASK
  STAT
}

// Cấp giao chỉ tiêu: Trung ương, tỉnh/thành phố, hoặc địa phương tự đặt.
enum IssuingLevel {
  CENTRAL
  PROVINCE
  LOCAL
}

// Nguồn giá trị thực hiện: báo cáo tay, tự tính từ kho dữ liệu, hoặc tổng hợp từ chỉ tiêu con.
enum ValueSource {
  MANUAL
  COMPUTED
  CHILDREN
}

enum DirectiveKind {
  KE_HOACH
  CHUONG_TRINH
  THONG_BAO_KET_LUAN
  CONG_VAN
  QUYET_DINH
  NGHI_QUYET
  CHI_THI
  BAO_CAO
  KHAC
}

enum EvaluationResult {
  EXCEEDED
  ACHIEVED
  PARTIAL
  NOT_ACHIEVED
}

enum EvidenceKind {
  FILE
  LINK
  DOCUMENT
}

enum ExplanationStatus {
  OPEN
  ANSWERED
  CANCELLED
}

enum BugReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum AgentActionStatus {
  PROPOSED
  EXECUTED
  CANCELLED
  FAILED
  EXPIRED
}

model Department {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  shortName           String?
  kind                DepartmentKind       @default(SPECIALIZED)
  // Lĩnh vực phụ trách: căn cứ gợi ý đơn vị chủ trì khi văn thư rà soát đề xuất.
  responsibilities    String?
  sortOrder           Int                  @default(0)
  description         String?
  color               String               @default("#0f766e")
  isActive            Boolean              @default(true)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  targets             Target[]
  importBatches       ImportBatch[]
  feedbacks           Feedback[]
  documents           SourceDocument[]
  indicatorCandidates IndicatorCandidate[]
  coordinatedTargets  TargetCoordinator[]
  datasets            Dataset[]
}

model User {
  id                      String                   @id @default(cuid())
  username                String                   @unique
  passwordHash            String
  fullName                String
  // Chức vụ hiển thị (Chủ tịch, Trưởng phòng, Chuyên viên…) — thẩm quyền vẫn do role quyết định.
  position                String?
  email                   String?                  @unique
  role                    Role                     @default(STAFF)
  isActive                Boolean                  @default(true)
  departmentId            String?
  department              Department?              @relation(fields: [departmentId], references: [id])
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastLoginAt             DateTime?
  tokenVersion            Int                      @default(1)
  version                 Int                      @default(1)
  updates                 ProgressUpdate[]
  assignedFeedbacks       Feedback[]               @relation("FeedbackAssignee")
  passwordResetChallenges PasswordResetChallenge[]
  uploadedDocuments       SourceDocument[]         @relation("DocumentUploader")
  reviewedCandidates      IndicatorCandidate[]     @relation("CandidateReviewer")
  agentActions            AgentAction[]            @relation("AgentActionUser")
  assignedTargets         Target[]                 @relation("TargetAssignee")
  notifications           Notification[]
  explanationRequests     ExplanationRequest[]     @relation("ExplanationRequester")
  bugReports              BugReport[]
}

model PasswordResetChallenge {
  id                  String    @id
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash             String
  expiresAt           DateTime
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  verifiedAt          DateTime?
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Target {
  id                       String               @id @default(cuid())
  code                     String               @unique
  title                    String
  description              String?
  // Bộ chỉ tiêu và vị trí trong bộ (STT, mã chuẩn như CT3, X0210, 6.4).
  frameworkId              String?
  framework                Framework?           @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  kind                     FrameworkKind        @default(PLAN)
  issuingLevel             IssuingLevel         @default(LOCAL)
  ordinal                  String?
  standardCode             String?
  // Nhóm trong bộ chỉ tiêu (vd "02. Kinh tế", "Nhận thức số") để hiển thị theo mục như văn bản giao.
  groupName                String?
  sortOrder                Int                  @default(0)
  parentId                 String?
  parent                   Target?              @relation("TargetTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                 Target[]             @relation("TargetTree")
  // Mục tiêu nguyên văn trong văn bản giao ("≥95", "Phấn đấu 100%") bên cạnh giá trị số.
  targetText               String?
  maxScore                 Float?
  scoringRule              String?
  evidenceRequirement      String?
  // Phiếu nguồn số liệu: lấy ở đâu, ai cung cấp, cách lấy — để người mới vẫn biết lấy số.
  dataSourceSystem         String?
  dataSourceAgency         String?
  collectionGuide          String?
  dataSourceUrl            String?
  reportDueDay             Int?
  valueSource              ValueSource          @default(MANUAL)
  formula                  Json?
  computedAt               DateTime?
  // Giao việc tới từng người; đếm số lần chuyển để chống "đá việc".
  assigneeId               String?
  assignee                 User?                @relation("TargetAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedAt               DateTime?
  assignedById             String?
  transferCount            Int                  @default(0)
  bounceCount              Int                  @default(0)
  unit                     String
  targetValue              Float
  currentValue             Float                @default(0)
  weight                   Float                @default(1)
  year                     Int
  frequency                TargetFrequency      @default(YEARLY)
  direction                TargetDirection      @default(HIGHER_IS_BETTER)
  status                   TargetStatus         @default(NOT_STARTED)
  version                  Int                  @default(1)
  publicationVersion       Int                  @default(1)
  isArchived               Boolean              @default(false)
  archivedAt               DateTime?
  archivedBy               String?
  archiveReason            String?
  isPublic                 Boolean              @default(false)
  isHighlighted            Boolean              @default(false)
  publicOrder              Int?
  lastReportedAt           DateTime?
  publishedValue           Float?
  publishedTargetValue     Float?
  publishedDirection       TargetDirection?
  publishedStatus          TargetStatus?
  publishedCode            String?
  publishedTitle           String?
  publishedDescription     String?
  publishedUnit            String?
  publishedWeight          Float?
  publishedYear            Int?
  publishedFrequency       TargetFrequency?
  publishedDueDate         DateTime?
  publishedDepartmentName  String?
  publishedDepartmentColor String?
  publishedHighlighted     Boolean?
  publishedOrder           Int?
  publishedAt              DateTime?
  publishedBy              String?
  dueDate                  DateTime
  departmentId             String
  department               Department           @relation(fields: [departmentId], references: [id])
  legalBasis               String?
  sourceDocumentId         String?
  sourceDocument           SourceDocument?      @relation("TargetSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  updates                  ProgressUpdate[]
  sourceCandidate          IndicatorCandidate?  @relation("CandidateCreatedTarget")
  matchedCandidates        IndicatorCandidate[] @relation("CandidateMatchedTarget")
  coordinators             TargetCoordinator[]
  directives               TargetDirective[]
  evaluations              TargetEvaluation[]
  evidences                Evidence[]
  workEvents               WorkEvent[]
  explanationRequests      ExplanationRequest[]

  @@index([year, status])
  @@index([departmentId])
  @@index([isArchived, year])
  @@index([frameworkId, sortOrder])
  @@index([parentId])
  @@index([assigneeId])
}

model ProgressUpdate {
  id            String               @id @default(cuid())
  value         Float
  // Kỳ báo cáo: 2026, 2026-H1, 2026-Q3, 2026-M09.
  periodKey     String?
  valueText     String?
  dataSource    String?
  explanation   String?
  autoApproved  Boolean              @default(false)
  note          String?
  reviewStatus  ProgressReviewStatus @default(APPROVED)
  baseVersion   Int                  @default(1)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime             @default(now())
  targetId      String
  target        Target               @relation(fields: [targetId], references: [id], onDelete: Cascade)
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  importBatchId String?
  importBatch   ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  evidences     Evidence[]

  @@index([reviewStatus, targetId])
  @@index([targetId, periodKey])
  @@index([importBatchId, reviewStatus])
}

model ImportBatch {
  id           String            @id @default(cuid())
  fileName     String
  totalRows    Int
  successRows  Int
  errorRows    Int
  errors       Json?
  changes      Json?
  createdBy    String
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  status       ImportBatchStatus @default(PREVIEWED)
  submittedAt  DateTime?
  appliedAt    DateTime?
  createdAt    DateTime          @default(now())
  updates      ProgressUpdate[]

  @@index([departmentId, createdAt])
}

model SystemSetting {
  id                          String   @id @default("default")
  defaultYear                 Int      @default(2026)
  warningDays                 Int      @default(14)
  riskThreshold               Float    @default(70)
  feedbackFirstResponseDays   Int      @default(2)
  feedbackResolutionDays      Int      @default(10)
  feedbackCitizenResponseDays Int      @default(7)
  // Cơ chế "không để việc bị treo" — đặt 0 để tắt từng cơ chế.
  reportAutoApproveDays       Int      @default(7)
  proposalAutoApproveDays     Int      @default(3)
  explanationDueDays          Int      @default(3)
  assignmentStallDays         Int      @default(3)
  maxTransfers                Int      @default(1)
  wallboardRotateSeconds      Int      @default(20)
  version                     Int      @default(1)
  updatedBy                   String?
  updatedAt                   DateTime @updatedAt
}

model Feedback {
  id                        String                 @id @default(cuid())
  code                      String                 @unique
  lookupSecretHash          String
  clientSubmissionId        String?                @unique
  title                     String
  content                   String
  category                  FeedbackCategory
  priority                  FeedbackPriority       @default(NORMAL)
  status                    FeedbackStatus         @default(RECEIVED)
  submitterName             String
  submitterPhone            String
  submitterEmail            String?
  address                   String?
  preferredContact          String                 @default("PHONE")
  consentAcceptedAt         DateTime
  scopeConfirmedAt          DateTime
  consentPolicyVersion      String
  departmentId              String?
  department                Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedToId              String?
  assignedTo                User?                  @relation("FeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueAt                     DateTime?
  firstResponseDueAt        DateTime?
  firstResponseAt           DateTime?
  waitingCitizenAt          DateTime?
  citizenResponseDueAt      DateTime?
  submittedForReviewAt      DateTime?
  submittedForReviewBy      String?
  resolvedAt                DateTime?
  closedAt                  DateTime?
  resolutionSummary         String?
  rejectionReason           String?
  closureReason             FeedbackClosureReason?
  version                   Int                    @default(1)
  reopenCount               Int                    @default(0)
  reopenRequestedAt         DateTime?
  reopenRequestReason       String?
  reopenRequestCount        Int                    @default(0)
  reopenRequestDecision     String?
  reopenRequestDecisionNote String?
  reopenRequestReviewedAt   DateTime?
  reopenRequestReviewedBy   String?
  rating                    Int?
  ratingComment             String?
  ratedAt                   DateTime?
  isPublic                  Boolean                @default(false)
  publicSnapshotVersion     Int                    @default(0)
  publicTitle               String?
  publicSummary             String?
  publicResolutionSummary   String?
  publicCategory            FeedbackCategory?
  publicDepartmentName      String?
  publicResolvedAt          DateTime?
  publicPublishedAt         DateTime?
  publicPublishedBy         String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  messages                  FeedbackMessage[]
  events                    FeedbackEvent[]
  attachments               FeedbackAttachment[]

  @@index([status, createdAt])
  @@index([departmentId, status])
  @@index([assignedToId, status])
  @@index([dueAt])
  @@index([citizenResponseDueAt])
  @@index([reopenRequestedAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model FeedbackAttachment {
  id           String   @id @default(cuid())
  feedbackId   String
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  size         Int
  sha256       String
  data         Bytes
  createdAt    DateTime @default(now())

  @@unique([feedbackId, sha256])
  @@index([feedbackId, createdAt])
}

model FeedbackMessage {
  id         String                    @id @default(cuid())
  feedbackId String
  feedback   Feedback                  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  body       String
  visibility FeedbackMessageVisibility @default(INTERNAL)
  authorId   String?
  authorName String
  createdAt  DateTime                  @default(now())

  @@index([feedbackId, createdAt])
}

model FeedbackEvent {
  id         String          @id @default(cuid())
  feedbackId String
  feedback   Feedback        @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  action     String
  fromStatus FeedbackStatus?
  toStatus   FeedbackStatus?
  actorId    String?
  actorName  String
  note       String?
  metadata   Json?
  createdAt  DateTime        @default(now())
  mailOutbox MailOutbox?

  @@index([feedbackId, createdAt])
}

model MailOutbox {
  feedbackEventId String           @id
  feedbackEvent   FeedbackEvent    @relation(fields: [feedbackEventId], references: [id], onDelete: Cascade)
  status          MailOutboxStatus @default(PENDING)
  payload         Json
  attempts        Int              @default(0)
  availableAt     DateTime         @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  sentAt          DateTime?
  lastError       String?          @db.VarChar(120)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
}

// Kho văn bản nguồn: mọi dữ liệu AI đề xuất đều phải truy vết được về một tài liệu.
model SourceDocument {
  id              String                @id @default(cuid())
  code            String                @unique
  title           String
  originalName    String
  mimeType        String
  size            Int
  sha256          String                @unique
  data            Bytes
  docType         DocumentType          @default(KHAC)
  docNumber       String?
  issuedBy        String?
  issuedDate      DateTime?
  description     String?
  status          DocumentStatus        @default(UPLOADED)
  processingError String?
  pageCount       Int?
  hasTextLayer    Boolean?
  ocrUsed         Boolean               @default(false)
  year            Int?
  departmentId    String?
  department      Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedById    String
  uploadedBy      User                  @relation("DocumentUploader", fields: [uploadedById], references: [id])
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  pages           DocumentPage[]
  chunks          DocumentChunk[]
  jobs            ExtractionJob[]
  candidates      IndicatorCandidate[]
  sourcedTargets  Target[]              @relation("TargetSourceDocument")
  publications    DocumentPublication[]
  directives      TargetDirective[]
  evidences       Evidence[]
  frameworks      Framework[]

  @@index([status, createdAt])
  @@index([departmentId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// Bản nháp duy nhất của trang dashboard công khai. Trang người dân không đọc
// trực tiếp bản ghi này mà chỉ đọc revision đã được công bố.
model PublicDashboard {
  id                String                    @id @default("public-home")
  draftName         String                    @default("Trang thông tin công khai")
  draftTemplateKey  String                    @default("transparency")
  draftConfig       Json                      @default("{}")
  draftVersion      Int                       @default(1)
  publishedRevision Int?
  updatedBy         String?
  updatedAt         DateTime                  @updatedAt
  revisions         PublicDashboardRevision[]
}

// Revision là lịch sử công bố bất biến. Khôi phục chỉ sao chép revision về bản
// nháp; không cập nhật hay xóa lịch sử đã phát hành.
model PublicDashboardRevision {
  id          String          @id @default(cuid())
  dashboardId String
  dashboard   PublicDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  revision    Int
  name        String
  templateKey String
  config      Json
  changeNote  String?
  publishedBy String
  publishedAt DateTime        @default(now())

  @@unique([dashboardId, revision])
  @@index([dashboardId, publishedAt(sort: Desc)])
}

// Bản chụp tệp dùng riêng cho kênh công khai. Công bố lần đầu hoặc công bố lại
// sau khi thu hồi tạo snapshot mới; chỉnh metadata của bản đang hiệu lực giữ
// nguyên id/publicCode và tăng version để không làm gãy dashboard đã công bố.
// Partial unique index trong migration giữ tối đa một bản đang hiệu lực.
model DocumentPublication {
  id               String         @id @default(cuid())
  sourceDocumentId String
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  publicCode       String         @unique
  title            String
  summary          String?
  originalName     String
  mimeType         String
  size             Int
  sha256           String
  data             Bytes
  publishedBy      String
  publishedAt      DateTime       @default(now())
  revokedAt        DateTime?
  revokedBy        String?
  version          Int            @default(1)

  @@index([sourceDocumentId, publishedAt(sort: Desc)])
  @@index([revokedAt, publishedAt(sort: Desc)])
}

model DocumentPage {
  id            String         @id @default(cuid())
  documentId    String
  document      SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int
  text          String
  ocrUsed       Boolean        @default(false)
  ocrConfidence Float?

  @@unique([documentId, pageNumber])
}

model DocumentChunk {
  id         String               @id @default(cuid())
  documentId String
  document   SourceDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  pageFrom   Int
  pageTo     Int
  text       String
  charCount  Int
  candidates IndicatorCandidate[]

  @@unique([documentId, chunkIndex])
}

// Hàng đợi xử lý bất đồng bộ theo mô hình MailOutbox: claim bằng FOR UPDATE SKIP LOCKED,
// lease 10 phút (job AI chạy lâu hơn gửi mail), backoff mũ, DEAD_LETTER khi hết lượt thử.
model ExtractionJob {
  id                String              @id @default(cuid())
  documentId        String
  document          SourceDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind              ExtractionJobKind
  status            ExtractionJobStatus @default(PENDING)
  attempts          Int                 @default(0)
  availableAt       DateTime            @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  lastError         String?             @db.VarChar(300)
  model             String?
  promptVersion     String?
  chunksTotal       Int?
  chunksDone        Int?
  note              String?
  startedAt         DateTime?
  finishedAt        DateTime?
  cancelRequestedAt DateTime?
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, availableAt])
  @@index([documentId, kind, createdAt])
}

// Hành động ghi dữ liệu do Copilot đề xuất: luôn qua preview, chỉ thực thi sau khi
// đúng người ra lệnh xác nhận trong thời hạn. Là sổ truy vết mọi thao tác agent.
model AgentAction {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("AgentActionUser", fields: [userId], references: [id])
  command       String
  tool          String
  parameters    Json
  preview       Json
  status        AgentActionStatus @default(PROPOSED)
  resultSummary String?
  result        Json?
  error         String?
  expiresAt     DateTime
  confirmedAt   DateTime?
  executedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, status, createdAt])
}

// Chỉ tiêu ứng viên do AI/rule đề xuất. Chỉ trở thành Target chính thức sau khi người có thẩm quyền duyệt.
model IndicatorCandidate {
  id                        String           @id @default(cuid())
  documentId                String?
  document                  SourceDocument?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  origin                    CandidateOrigin  @default(AI)
  frameworkId               String?
  framework                 Framework?       @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  targetKind                FrameworkKind    @default(PLAN)
  issuingLevel              IssuingLevel?
  standardCode              String?
  targetText                String?
  proposedById              String?
  submittedById             String?
  submittedAt               DateTime?
  // Hạn tự thông qua khi người duyệt không xử lý (chỉ đặt khi đã trình).
  autoApproveAt             DateTime?
  autoApproved              Boolean          @default(false)
  chunkId                   String?
  chunk                     DocumentChunk?   @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  pageNumber                Int?
  kind                      CandidateKind    @default(NEW_INDICATOR)
  status                    CandidateStatus  @default(PROPOSED)
  extractionMethod          ExtractionMethod
  model                     String?
  promptVersion             String?
  name                      String
  ordinal                   String?
  parentName                String?
  description               String?
  category                  String?
  unit                      String?
  targetValue               Float?
  actualValue               Float?
  targetYear                Int?
  direction                 TargetDirection?
  frequency                 TargetFrequency?
  deadline                  DateTime?
  responsibleDepartmentName String?
  responsibleDepartmentId   String?
  responsibleDepartment     Department?      @relation(fields: [responsibleDepartmentId], references: [id], onDelete: SetNull)
  coordinatingDepartments   String?
  legalBasis                String?
  formula                   String?
  sourceQuote               String           @default("")
  confidence                Float
  fieldConfidence           Json?
  warnings                  Json?
  isDuplicateSuspect        Boolean          @default(false)
  matchedTargetId           String?
  matchedTarget             Target?          @relation("CandidateMatchedTarget", fields: [matchedTargetId], references: [id], onDelete: SetNull)
  humanEdited               Boolean          @default(false)
  editedFields              Json?
  reviewNote                String?
  reviewedById              String?
  reviewedBy                User?            @relation("CandidateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  createdTargetId           String?          @unique
  createdTarget             Target?          @relation("CandidateCreatedTarget", fields: [createdTargetId], references: [id], onDelete: SetNull)
  version                   Int              @default(1)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  workEvents WorkEvent[]

  @@index([status, createdAt])
  @@index([documentId, status])
  @@index([status, autoApproveAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String
  actorUsername String
  actorRole     Role
  action        String
  entityType    String
  entityId      String?
  departmentId  String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([departmentId, createdAt])
  @@index([actorId, createdAt])
}

// ───────────────────────── IOC v2: địa phương, bộ chỉ tiêu, trách nhiệm, dữ liệu ─────────────────────────

// Hồ sơ địa phương (một bản ghi). Mọi tên hiển thị, tiêu đề, email, tệp xuất đều đọc từ đây —
// mang hệ thống sang xã/phường khác chỉ cần chạy trình thiết lập, không sửa mã.
model LocalityProfile {
  id               String       @id @default("default")
  kind             LocalityKind @default(PHUONG)
  name             String
  agencyName       String
  shortName        String
  provinceName     String?
  adminUnitCode    String?
  agencyCode       String?
  address          String?
  phone            String?
  email            String?
  website          String?
  emailDomain      String?
  primaryColor     String       @default("#1d4ed8")
  setupCompletedAt DateTime?
  appliedTemplates String[]     @default([])
  version          Int          @default(1)
  updatedBy        String?
  updatedAt        DateTime     @updatedAt
}

// Bộ chỉ tiêu: một văn bản giao hoặc một bộ chỉ số (KT-XH, chuyển đổi số, CCHC, thống kê…).
model Framework {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  kind             FrameworkKind        @default(PLAN)
  issuingLevel     IssuingLevel         @default(LOCAL)
  year             Int?
  legalBasis       String?
  description      String?
  maxScore         Float?
  templateKey      String?
  sourceDocumentId String?
  sourceDocument   SourceDocument?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  sortOrder        Int                  @default(0)
  showOnWallboard  Boolean              @default(true)
  isActive         Boolean              @default(true)
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  targets          Target[]
  candidates       IndicatorCandidate[]

  @@index([isActive, sortOrder])
}

model TargetCoordinator {
  targetId     String
  target       Target     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([targetId, departmentId])
  @@index([departmentId])
}

// Phần 1 của hồ sơ chỉ tiêu: các văn bản chỉ đạo điều hành (một chỉ tiêu có thể có nhiều văn bản).
model TargetDirective {
  id               String          @id @default(cuid())
  targetId         String
  target           Target          @relation(fields: [targetId], references: [id], onDelete: Cascade)
  kind             DirectiveKind   @default(KHAC)
  docNumber        String?
  title            String
  issuedDate       DateTime?
  issuer           String?
  note             String?
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdById      String
  createdByName    String
  createdAt        DateTime        @default(now())
  evidences        Evidence[]

  @@index([targetId, issuedDate])
}

// Phần 3 của hồ sơ chỉ tiêu: đánh giá theo kỳ (đạt / vượt / không đạt + biện pháp chấn chỉnh).
model TargetEvaluation {
  id               String           @id @default(cuid())
  targetId         String
  target           Target           @relation(fields: [targetId], references: [id], onDelete: Cascade)
  periodKey        String
  result           EvaluationResult
  score            Float?
  note             String?
  correctiveAction String?
  evaluatedById    String
  evaluatedByName  String
  evaluatedByRole  Role
  evaluatedAt      DateTime         @default(now())
  version          Int              @default(1)
  evidences        Evidence[]

  @@unique([targetId, periodKey])
}

// Minh chứng: tệp (ảnh chụp màn hình phần mềm nguồn, biên bản, kế hoạch…), liên kết, hoặc văn bản trong kho.
model Evidence {
  id               String            @id @default(cuid())
  targetId         String
  target           Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  progressUpdateId String?
  progressUpdate   ProgressUpdate?   @relation(fields: [progressUpdateId], references: [id], onDelete: Cascade)
  directiveId      String?
  directive        TargetDirective?  @relation(fields: [directiveId], references: [id], onDelete: Cascade)
  evaluationId     String?
  evaluation       TargetEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  kind             EvidenceKind      @default(FILE)
  title            String
  originalName     String?
  mimeType         String?
  size             Int?
  sha256           String?
  data             Bytes?
  url              String?
  sourceDocumentId String?
  sourceDocument   SourceDocument?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  note             String?
  capturedAt       DateTime?
  createdById      String
  createdByName    String
  createdAt        DateTime          @default(now())

  @@index([targetId, createdAt])
  @@index([progressUpdateId])
}

// Dòng thời gian trách nhiệm: ai giao, ai chuyển, ai trả lại, hệ thống nhắc hoặc tự thông qua lúc nào.
// actorId null nghĩa là hệ thống tự thực hiện theo quy tắc thời hạn.
model WorkEvent {
  id                String              @id @default(cuid())
  targetId          String?
  target            Target?             @relation(fields: [targetId], references: [id], onDelete: Cascade)
  candidateId       String?
  candidate         IndicatorCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  action            String
  actorId           String?
  actorName         String
  // Người chịu trách nhiệm cho sự kiện (vd trưởng phòng để quá hạn duyệt) — phục vụ mục trách nhiệm người đứng đầu.
  responsibleUserId String?
  departmentId      String?
  note              String?
  metadata          Json?
  createdAt         DateTime            @default(now())

  @@index([targetId, createdAt])
  @@index([candidateId, createdAt])
  @@index([responsibleUserId, action, createdAt])
  @@index([departmentId, createdAt])
  @@index([createdAt])
}

model ExplanationRequest {
  id            String            @id @default(cuid())
  targetId      String
  target        Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User              @relation("ExplanationRequester", fields: [requestedById], references: [id])
  message       String
  dueAt         DateTime
  status        ExplanationStatus @default(OPEN)
  response      String?
  responderId   String?
  responderName String?
  respondedAt   DateTime?
  createdAt     DateTime          @default(now())
  version       Int               @default(1)

  @@index([targetId, status])
  @@index([status, dueAt])
}

// Thông báo trong ứng dụng. dedupeKey duy nhất để bộ giám sát chạy lại không nhắc trùng.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  body       String?
  link       String?
  entityType String?
  entityId   String?
  dedupeKey  String    @unique
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Kho dữ liệu nghiệp vụ: bảng có cấu trúc để chỉ tiêu tự tính (vd cuộc họp CĐS, hồ sơ TTHC…).
model Dataset {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  description       String?
  columns           Json
  ownerDepartmentId String?
  ownerDepartment   Department?  @relation(fields: [ownerDepartmentId], references: [id], onDelete: SetNull)
  updateCycle       String?
  sourceSystem      String?
  collectionGuide   String?
  templateKey       String?
  isActive          Boolean      @default(true)
  version           Int          @default(1)
  lastDataAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  rows              DatasetRow[]
}

model DatasetRow {
  id          String   @id @default(cuid())
  datasetId   String
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  data        Json
  createdById String
  updatedById String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([datasetId, createdAt])
}

// Báo lỗi có ngữ cảnh: ghi lại đúng trang, lúc nào, để biết lỗi ở đâu mà sửa.
model BugReport {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  reporterName   String
  url            String
  pageTitle      String?
  screenCode     String?
  viewport       String?
  userAgent      String?
  description    String
  screenshot     Bytes?
  screenshotMime String?
  status         BugReportStatus @default(NEW)
  adminNote      String?
  resolvedById   String?
  resolvedAt     DateTime?
  version        Int             @default(1)
  createdAt      DateTime        @default(now())

  @@index([status, createdAt])
}
