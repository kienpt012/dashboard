generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum TargetStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  OVERDUE
  COMPLETED
}

enum TargetFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum TargetDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum ProgressReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportBatchStatus {
  PREVIEWED
  SUBMITTED
  PARTIALLY_REVIEWED
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  APPLIED
  FAILED
}

enum FeedbackCategory {
  INFRASTRUCTURE
  ENVIRONMENT
  ADMINISTRATIVE_PROCEDURE
  SECURITY_ORDER
  SOCIAL_WELFARE
  CULTURE_EDUCATION
  OTHER
}

enum FeedbackPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FeedbackStatus {
  RECEIVED
  ASSIGNED
  IN_PROGRESS
  WAITING_CITIZEN
  PENDING_REVIEW
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
}

enum FeedbackMessageVisibility {
  INTERNAL
  PUBLIC
}

enum FeedbackClosureReason {
  RESOLVED
  NO_CITIZEN_RESPONSE
  OUT_OF_SCOPE
}

enum MailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD_LETTER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum DocumentType {
  KE_HOACH
  QUYET_DINH
  CONG_VAN
  BAO_CAO
  NGHI_QUYET
  PHU_LUC
  KHAC
}

enum ExtractionJobKind {
  DOCUMENT_PARSE
  INDICATOR_EXTRACT
}

enum ExtractionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum ExtractionMethod {
  RULE_BASED
  LLM
}

enum CandidateKind {
  NEW_INDICATOR
  PROGRESS_UPDATE
}

enum CandidateStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum AgentActionStatus {
  PROPOSED
  EXECUTED
  CANCELLED
  FAILED
  EXPIRED
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  color       String   @default("#0f766e")
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  targets     Target[]
  importBatches ImportBatch[]
  feedbacks   Feedback[]
  documents   SourceDocument[]
  indicatorCandidates IndicatorCandidate[]
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  fullName     String
  email        String?     @unique
  role         Role        @default(STAFF)
  isActive     Boolean     @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastLoginAt  DateTime?
  tokenVersion Int         @default(1)
  version      Int         @default(1)
  updates      ProgressUpdate[]
  assignedFeedbacks Feedback[] @relation("FeedbackAssignee")
  passwordResetChallenges PasswordResetChallenge[]
  uploadedDocuments SourceDocument[] @relation("DocumentUploader")
  reviewedCandidates IndicatorCandidate[] @relation("CandidateReviewer")
  agentActions AgentAction[] @relation("AgentActionUser")
}

model PasswordResetChallenge {
  id                  String    @id
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash             String
  expiresAt           DateTime
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  verifiedAt          DateTime?
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Target {
  id            String          @id @default(cuid())
  code          String          @unique
  title         String
  description   String?
  unit          String
  targetValue   Float
  currentValue  Float           @default(0)
  weight        Float           @default(1)
  year          Int
  frequency     TargetFrequency @default(YEARLY)
  direction     TargetDirection @default(HIGHER_IS_BETTER)
  status        TargetStatus    @default(NOT_STARTED)
  version       Int             @default(1)
  publicationVersion Int        @default(1)
  isArchived    Boolean         @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  archiveReason String?
  isPublic      Boolean         @default(false)
  isHighlighted Boolean         @default(false)
  publicOrder   Int?
  lastReportedAt DateTime?
  publishedValue Float?
  publishedTargetValue Float?
  publishedDirection TargetDirection?
  publishedStatus TargetStatus?
  publishedCode String?
  publishedTitle String?
  publishedDescription String?
  publishedUnit String?
  publishedWeight Float?
  publishedYear Int?
  publishedFrequency TargetFrequency?
  publishedDueDate DateTime?
  publishedDepartmentName String?
  publishedDepartmentColor String?
  publishedHighlighted Boolean?
  publishedOrder Int?
  publishedAt DateTime?
  publishedBy String?
  dueDate       DateTime
  departmentId  String
  department    Department      @relation(fields: [departmentId], references: [id])
  legalBasis    String?
  sourceDocumentId String?
  sourceDocument SourceDocument? @relation("TargetSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  updates       ProgressUpdate[]
  sourceCandidate IndicatorCandidate? @relation("CandidateCreatedTarget")
  matchedCandidates IndicatorCandidate[] @relation("CandidateMatchedTarget")

  @@index([year, status])
  @@index([departmentId])
  @@index([isArchived, year])
}

model ProgressUpdate {
  id        String   @id @default(cuid())
  value     Float
  note      String?
  reviewStatus ProgressReviewStatus @default(APPROVED)
  baseVersion Int @default(1)
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt DateTime @default(now())
  targetId  String
  target    Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  importBatchId String?
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([reviewStatus, targetId])
  @@index([importBatchId, reviewStatus])
}

model ImportBatch {
  id          String   @id @default(cuid())
  fileName    String
  totalRows   Int
  successRows Int
  errorRows   Int
  errors      Json?
  changes     Json?
  createdBy   String
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id])
  status      ImportBatchStatus @default(PREVIEWED)
  submittedAt DateTime?
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
  updates     ProgressUpdate[]

  @@index([departmentId, createdAt])
}

model SystemSetting {
  id            String   @id @default("default")
  defaultYear   Int      @default(2026)
  warningDays   Int      @default(14)
  riskThreshold Float    @default(70)
  feedbackFirstResponseDays Int @default(2)
  feedbackResolutionDays Int @default(10)
  feedbackCitizenResponseDays Int @default(7)
  version       Int      @default(1)
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}

model Feedback {
  id                 String           @id @default(cuid())
  code               String           @unique
  lookupSecretHash   String
  clientSubmissionId String?          @unique
  title              String
  content            String
  category           FeedbackCategory
  priority           FeedbackPriority @default(NORMAL)
  status             FeedbackStatus   @default(RECEIVED)
  submitterName      String
  submitterPhone     String
  submitterEmail     String?
  address            String?
  preferredContact   String            @default("PHONE")
  consentAcceptedAt  DateTime
  scopeConfirmedAt   DateTime
  consentPolicyVersion String
  departmentId       String?
  department         Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedToId       String?
  assignedTo         User?             @relation("FeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueAt              DateTime?
  firstResponseDueAt DateTime?
  firstResponseAt    DateTime?
  waitingCitizenAt  DateTime?
  citizenResponseDueAt DateTime?
  submittedForReviewAt DateTime?
  submittedForReviewBy String?
  resolvedAt         DateTime?
  closedAt           DateTime?
  resolutionSummary  String?
  rejectionReason    String?
  closureReason      FeedbackClosureReason?
  version            Int              @default(1)
  reopenCount        Int              @default(0)
  reopenRequestedAt  DateTime?
  reopenRequestReason String?
  reopenRequestCount Int              @default(0)
  reopenRequestDecision String?
  reopenRequestDecisionNote String?
  reopenRequestReviewedAt DateTime?
  reopenRequestReviewedBy String?
  rating             Int?
  ratingComment      String?
  ratedAt            DateTime?
  isPublic           Boolean          @default(false)
  publicSnapshotVersion Int           @default(0)
  publicTitle        String?
  publicSummary      String?
  publicResolutionSummary String?
  publicCategory     FeedbackCategory?
  publicDepartmentName String?
  publicResolvedAt   DateTime?
  publicPublishedAt  DateTime?
  publicPublishedBy  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  messages           FeedbackMessage[]
  events             FeedbackEvent[]
  attachments        FeedbackAttachment[]

  @@index([status, createdAt])
  @@index([departmentId, status])
  @@index([assignedToId, status])
  @@index([dueAt])
  @@index([citizenResponseDueAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model FeedbackAttachment {
  id           String   @id @default(cuid())
  feedbackId   String
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  size         Int
  sha256       String
  data         Bytes
  createdAt    DateTime @default(now())

  @@unique([feedbackId, sha256])
  @@index([feedbackId, createdAt])
}

model FeedbackMessage {
  id         String                    @id @default(cuid())
  feedbackId String
  feedback   Feedback                  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  body       String
  visibility FeedbackMessageVisibility @default(INTERNAL)
  authorId   String?
  authorName String
  createdAt  DateTime                  @default(now())

  @@index([feedbackId, createdAt])
}

model FeedbackEvent {
  id         String          @id @default(cuid())
  feedbackId String
  feedback   Feedback        @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  action     String
  fromStatus FeedbackStatus?
  toStatus   FeedbackStatus?
  actorId    String?
  actorName  String
  note       String?
  metadata   Json?
  createdAt  DateTime        @default(now())
  mailOutbox MailOutbox?

  @@index([feedbackId, createdAt])
}

model MailOutbox {
  feedbackEventId String           @id
  feedbackEvent   FeedbackEvent    @relation(fields: [feedbackEventId], references: [id], onDelete: Cascade)
  status          MailOutboxStatus @default(PENDING)
  payload         Json
  attempts        Int              @default(0)
  availableAt     DateTime         @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  sentAt          DateTime?
  lastError       String?          @db.VarChar(120)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
}

// Kho văn bản nguồn: mọi dữ liệu AI đề xuất đều phải truy vết được về một tài liệu.
model SourceDocument {
  id              String         @id @default(cuid())
  code            String         @unique
  title           String
  originalName    String
  mimeType        String
  size            Int
  sha256          String         @unique
  data            Bytes
  docType         DocumentType   @default(KHAC)
  docNumber       String?
  issuedBy        String?
  issuedDate      DateTime?
  description     String?
  status          DocumentStatus @default(UPLOADED)
  processingError String?
  pageCount       Int?
  hasTextLayer    Boolean?
  ocrUsed         Boolean        @default(false)
  year            Int?
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedById    String
  uploadedBy      User           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  pages           DocumentPage[]
  chunks          DocumentChunk[]
  jobs            ExtractionJob[]
  candidates      IndicatorCandidate[]
  sourcedTargets  Target[]       @relation("TargetSourceDocument")

  @@index([status, createdAt])
  @@index([departmentId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model DocumentPage {
  id            String         @id @default(cuid())
  documentId    String
  document      SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int
  text          String
  ocrUsed       Boolean        @default(false)
  ocrConfidence Float?

  @@unique([documentId, pageNumber])
}

model DocumentChunk {
  id         String         @id @default(cuid())
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  pageFrom   Int
  pageTo     Int
  text       String
  charCount  Int
  candidates IndicatorCandidate[]

  @@unique([documentId, chunkIndex])
}

// Hàng đợi xử lý bất đồng bộ theo mô hình MailOutbox: claim bằng FOR UPDATE SKIP LOCKED,
// lease 10 phút (job AI chạy lâu hơn gửi mail), backoff mũ, DEAD_LETTER khi hết lượt thử.
model ExtractionJob {
  id            String              @id @default(cuid())
  documentId    String
  document      SourceDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind          ExtractionJobKind
  status        ExtractionJobStatus @default(PENDING)
  attempts      Int                 @default(0)
  availableAt   DateTime            @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  lastError     String?             @db.VarChar(300)
  model         String?
  promptVersion String?
  chunksTotal   Int?
  chunksDone    Int?
  note          String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, availableAt])
  @@index([documentId, kind, createdAt])
}

// Hành động ghi dữ liệu do Copilot đề xuất: luôn qua preview, chỉ thực thi sau khi
// đúng người ra lệnh xác nhận trong thời hạn. Là sổ truy vết mọi thao tác agent.
model AgentAction {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("AgentActionUser", fields: [userId], references: [id])
  command       String
  tool          String
  parameters    Json
  preview       Json
  status        AgentActionStatus @default(PROPOSED)
  resultSummary String?
  result        Json?
  error         String?
  expiresAt     DateTime
  confirmedAt   DateTime?
  executedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, status, createdAt])
}

// Chỉ tiêu ứng viên do AI/rule đề xuất. Chỉ trở thành Target chính thức sau khi người có thẩm quyền duyệt.
model IndicatorCandidate {
  id                        String           @id @default(cuid())
  documentId                String
  document                  SourceDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkId                   String?
  chunk                     DocumentChunk?   @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  pageNumber                Int?
  kind                      CandidateKind    @default(NEW_INDICATOR)
  status                    CandidateStatus  @default(PROPOSED)
  extractionMethod          ExtractionMethod
  model                     String?
  promptVersion             String?
  name                      String
  description               String?
  category                  String?
  unit                      String?
  targetValue               Float?
  actualValue               Float?
  targetYear                Int?
  direction                 TargetDirection?
  frequency                 TargetFrequency?
  deadline                  DateTime?
  responsibleDepartmentName String?
  responsibleDepartmentId   String?
  responsibleDepartment     Department?      @relation(fields: [responsibleDepartmentId], references: [id], onDelete: SetNull)
  coordinatingDepartments   String?
  legalBasis                String?
  formula                   String?
  sourceQuote               String
  confidence                Float
  fieldConfidence           Json?
  warnings                  Json?
  isDuplicateSuspect        Boolean          @default(false)
  matchedTargetId           String?
  matchedTarget             Target?          @relation("CandidateMatchedTarget", fields: [matchedTargetId], references: [id], onDelete: SetNull)
  humanEdited               Boolean          @default(false)
  editedFields              Json?
  reviewNote                String?
  reviewedById              String?
  reviewedBy                User?            @relation("CandidateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  createdTargetId           String?          @unique
  createdTarget             Target?          @relation("CandidateCreatedTarget", fields: [createdTargetId], references: [id], onDelete: SetNull)
  version                   Int              @default(1)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([documentId, status])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String
  actorUsername String
  actorRole     Role
  action        String
  entityType    String
  entityId      String?
  departmentId  String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([departmentId, createdAt])
  @@index([actorId, createdAt])
}
