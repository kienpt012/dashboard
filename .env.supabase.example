# Copy this file to .env.supabase.local. The local file is ignored by Git.
# The deploy script percent-encodes special characters in the password.
#
# IOC uses a private `ioc` schema instead of `public`, so Supabase Data API
# does not expose application tables unless that schema is explicitly enabled.

SUPABASE_PROJECT_REF=PROJECT_REF
SUPABASE_POOLER_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PASSWORD=PASTE_DATABASE_PASSWORD_HERE

# Optional advanced overrides. Leave blank to let the deploy script construct
# both URLs with the Supavisor session-mode pooler (IPv4), port 5432.
DATABASE_URL=
DIRECT_URL=
