POSTGRES_DB=ioc_laithieu
POSTGRES_USER=ioc_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PASSWORD_RESET_PEPPER=replace-with-another-random-secret

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
CORS_ORIGINS=http://your-server-ip
PUBLIC_APP_URL=http://your-server-ip

# Chỉ bật trong lần khởi tạo cơ sở dữ liệu demo đầu tiên, sau đó đổi về false.
# Hai mật khẩu bên dưới phải dài ít nhất 12 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
RUN_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_USER_PASSWORD=replace-with-a-different-strong-demo-password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EXTRACT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT_MS=480000
OLLAMA_NUM_CTX=4096
EXTRACTION_POLL_MS=4000
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_MAX_OCR_PAGES=20
EXTRACTION_MAX_LLM_CHUNKS=20
DISABLE_EXTRACTION_WORKER=false
