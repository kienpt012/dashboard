POSTGRES_DB=ioc_laithieu
POSTGRES_USER=ioc_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PASSWORD_RESET_PEPPER=replace-with-another-random-secret

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
CORS_ORIGINS=http://your-server-ip
PUBLIC_APP_URL=http://your-server-ip

# Chỉ bật trong lần khởi tạo cơ sở dữ liệu demo đầu tiên, sau đó đổi về false.
# Hai mật khẩu bên dưới phải dài ít nhất 12 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
RUN_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_USER_PASSWORD=replace-with-a-different-strong-demo-password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EXTRACT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT_MS=480000
OLLAMA_HEALTH_TIMEOUT_MS=10000
OLLAMA_NUM_CTX=4096
EXTRACTION_POLL_MS=4000
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_MAX_OCR_PAGES=0
EXTRACTION_MAX_LLM_CHUNKS=20
DISABLE_EXTRACTION_WORKER=false
# Quy trình xử lý văn bản bản 2: ocr-service (Docling + RapidOCR + VietOCR) đọc B2–B6.
# Bật: COMPOSE_PROFILES=ocr và OCR_SERVICE_URL=http://ocr:8000. Để trống thì API dùng bộ đọc dự phòng pdf.js + Tesseract.
COMPOSE_PROFILES=
OCR_SERVICE_URL=
OCR_SERVICE_PAGE_BATCH=4
OCR_SERVICE_TIMEOUT_MS=900000
OCR_DPI=216
OCR_THREADS=4
# B7: độ dài mục tiêu mỗi đoạn gửi Qwen; bảng gửi dạng chữ thường (plain) như dữ liệu fine-tune, hoặc markdown.
CHUNK_TARGET_CHARS=1400
CHUNK_TABLE_FORMAT=plain
# B8, B11: giữ model nạp sẵn trong Ollama giữa các lần gọi. OLLAMA_THINK=false chỉ dùng cho model có bước suy nghĩ.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=
# B14: ngưỡng cosine (bge-m3) trùng / gần trùng, giá trị khởi điểm cần hiệu chỉnh trên dữ liệu đã gán nhãn.
MATCH_DUPLICATE_THRESHOLD=0.95
MATCH_NEAR_THRESHOLD=0.85

