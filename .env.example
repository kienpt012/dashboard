# =============================================================================
#  Cấu hình IOC
#
#  KHÔNG cần sửa file này để chạy thử trên máy: start-ioc.cmd tự tạo .env từ đây,
#  thay mọi giá trị "replace-with-..." bằng mật khẩu và khoá ngẫu nhiên, rồi in mật
#  khẩu đăng nhập ra màn hình ở lần chạy đầu tiên.
#
#  Chỉ sửa khi cần đổi cổng, cấu hình email hoặc triển khai thật.
# =============================================================================

# Tên dự án Docker Compose (quyết định tên volume dữ liệu) và tiền tố tên container/image.
# Mặc định lấy theo tên thư mục. start-ioc.cmd tự đặt tên riêng khi phát hiện một bản IOC
# khác trên cùng máy đang dùng tên đó, nên thường không cần sửa.
# COMPOSE_PROJECT_NAME=ioc-laithieu
# IOC_INSTANCE=ioc-laithieu

POSTGRES_DB=ioc_laithieu
POSTGRES_USER=ioc_admin
# Docker tự mã hóa mật khẩu khi tạo chuỗi kết nối, nên có thể dùng đầy đủ ký tự đặc biệt.
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Chỉ dùng khi chạy API trực tiếp ngoài Docker. Nếu mật khẩu có ký tự đặc biệt,
# hãy percent-encode phần tên đăng nhập và mật khẩu trong URL này.
DATABASE_URL=postgresql://ioc_admin:replace-with-a-random-database-password@localhost:5432/ioc_laithieu?schema=public
# Prisma Migrate dùng kết nối trực tiếp/session; local dùng cùng URL với DATABASE_URL.
DIRECT_URL=postgresql://ioc_admin:replace-with-a-random-database-password@localhost:5432/ioc_laithieu?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Khuyến nghị đặt chuỗi ngẫu nhiên khác JWT_SECRET (tối thiểu 32 ký tự).
# Để trống thì hệ thống dùng JWT_SECRET làm khóa HMAC cho mã khôi phục.
PASSWORD_RESET_PEPPER=
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Danh sách hostname HTTPS ngoài hệ thống được phép dùng trong nút CTA của dashboard công khai.
# Để trống để chỉ cho phép đường dẫn nội bộ, ví dụ: dichvucong.gov.vn,www.example.gov.vn
PUBLIC_DASHBOARD_ALLOWED_LINK_HOSTS=
# Giữ false. start-ioc.cmd tự tạo dữ liệu mẫu MỘT LẦN khi cơ sở dữ liệu còn trống,
# bằng lệnh `docker compose exec api ./docker-entrypoint.sh seed`. Production luôn giữ false.
RUN_DEMO_SEED=false
# Mật khẩu của tài khoản quản trị (admin) và các tài khoản dùng thử, chỉ dùng khi tạo dữ liệu
# mẫu lần đầu. start-ioc.cmd tự thay hai giá trị mặc định dưới đây bằng mật khẩu mạnh ngẫu nhiên;
# seed từ chối mọi mật khẩu yếu hoặc mặc định. Đổi sau khi đã tạo tài khoản sẽ KHÔNG có tác dụng.
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_USER_PASSWORD=Demo@12345
PORT=3000
# Cổng mở ra trên máy. Đổi nếu máy đã có chương trình khác dùng các cổng này
# (hay gặp nhất: một PostgreSQL cài sẵn đang chiếm 5432).
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432
# Chỉ dùng cho npm run dev; bản Docker dùng API cùng tên miền qua /api.
VITE_API_URL=http://localhost:3000/api

# SMTP dùng cho OTP quên mật khẩu và thông báo tiến độ phản ánh.
# Điền tài khoản SMTP tại SMTP_USER và mật khẩu/mật khẩu ứng dụng tại SMTP_PASS.
# Cổng 587 thường dùng SMTP_SECURE=false; cổng 465 dùng SMTP_SECURE=true.
# Với kết nối không secure, hệ thống mặc định bắt buộc nâng cấp STARTTLS và TLS >= 1.2.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Worker email tiến độ: lấy theo lô, thử lại tối đa và giữ dead-letter để đối soát.
MAIL_OUTBOX_POLL_MS=5000
MAIL_OUTBOX_BATCH_SIZE=10
MAIL_OUTBOX_MAX_ATTEMPTS=8
# Production phải dùng địa chỉ công khai hợp lệ, không được dùng localhost/127.0.0.1.
PUBLIC_APP_URL=http://localhost:8080

# ==== Lớp AI cục bộ (trích xuất chỉ tiêu từ văn bản) ====
# Ollama chạy trên máy host; trong Docker dùng host.docker.internal, chạy trực tiếp dùng 127.0.0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EXTRACT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT_MS=480000
# Job trích xuất hỏi Ollama tối đa 3 lần, mỗi lần chờ chừng này ms, trước khi chuyển sang bộ luật.
OLLAMA_HEALTH_TIMEOUT_MS=10000
OLLAMA_NUM_CTX=4096
# 0 = chạy model chỉ trên CPU (máy GPU nhỏ: tránh Ollama nạp một phần lên GPU rồi chậm hoặc hết bộ nhớ). Bỏ trống = Ollama tự chọn.
OLLAMA_NUM_GPU=
# Chạy API ngoài Docker trên Windows cần trỏ tesseract và thư mục traineddata tiếng Việt.
# Trong Docker image đã cài sẵn Tesseract cùng dữ liệu vie + eng nên để trống hai đường dẫn.
TESSERACT_PATH=
TESSDATA_DIR=
TESSERACT_LANGS=vie+eng
# Worker trích xuất: chu kỳ quét, số lần thử lại, giới hạn trang OCR mỗi tài liệu của bộ đọc dự phòng (0 = không giới hạn).
EXTRACTION_POLL_MS=4000
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_MAX_OCR_PAGES=0
EXTRACTION_MAX_LLM_CHUNKS=40
# true: đoạn Qwen đã đọc vẫn thêm ứng viên luật mà Qwen không có (bổ khuyết kiểu D-007). Mặc định tắt (D-016).
EXTRACTION_RULE_FILL_IN=false
# Kiểm tra đủ mục: số lần tối đa hỏi lại Qwen cho các mục đánh số còn thiếu trong một văn bản; 0 = chỉ ghi chú.
EXTRACTION_RECHECK_MAX=10
# Nhớ kết quả Qwen theo đoạn (số ngày giữ): "Đọc lại" chỉ gọi Qwen cho đoạn, prompt hoặc model đã đổi. 0 = tắt.
EXTRACTION_LLM_CACHE_DAYS=90
# Bảng đã có hàng, cột (phụ lục, biểu giao chỉ tiêu, Excel) được đọc bằng code thay vì gửi Qwen (D-022). false = tắt.
EXTRACTION_TABLE_READER=true
# Lọc đoạn trước khi gọi Qwen: target = chỉ gửi đoạn có con số trông như mức cần đạt (D-023); basic = bộ lọc cũ.
EXTRACTION_CHUNK_FILTER=target
# Số đoạn gửi Qwen cùng lúc. auto = 1 khi Ollama chạy model trên CPU, 2 khi model nằm trên GPU (đặt OLLAMA_NUM_PARALLEL=2
# cho Ollama). Đặt số 1–8 để ép; trên CPU để 1 vì chạy song song chỉ làm các yêu cầu chờ nhau tới hết giờ.
EXTRACTION_LLM_CONCURRENCY=auto
# Chỉ bật khi cần chẩn đoán API mà không muốn worker lấy tác vụ nền.
DISABLE_EXTRACTION_WORKER=false
# Quy trình xử lý văn bản bản 2: ocr-service (Docling + RapidOCR + VietOCR) đọc B2–B6.
# Bật: COMPOSE_PROFILES=ocr và OCR_SERVICE_URL=http://ocr:8000. Để trống thì API dùng bộ đọc dự phòng pdf.js + Tesseract.
COMPOSE_PROFILES=
OCR_SERVICE_URL=
OCR_SERVICE_PAGE_BATCH=4
OCR_SERVICE_TIMEOUT_MS=900000
OCR_DPI=216
OCR_THREADS=4
# B7: độ dài mục tiêu mỗi đoạn gửi Qwen; bảng gửi dạng chữ thường (plain) như dữ liệu fine-tune, hoặc markdown.
CHUNK_TARGET_CHARS=1400
# Đoạn văn có quá N con số (mục (1)–(13) viết liền) thì tách tiếp theo câu, để Qwen trên CPU trả lời kịp thời gian chờ.
CHUNK_MAX_NUMBERS=12
CHUNK_TABLE_FORMAT=plain
# B8, B11: giữ model nạp sẵn trong Ollama giữa các lần gọi. OLLAMA_THINK=false chỉ dùng cho model có bước suy nghĩ.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=
# B14: ngưỡng cosine (bge-m3) trùng / gần trùng, giá trị khởi điểm cần hiệu chỉnh trên dữ liệu đã gán nhãn.
MATCH_DUPLICATE_THRESHOLD=0.95
MATCH_NEAR_THRESHOLD=0.85
