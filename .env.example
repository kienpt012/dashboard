POSTGRES_DB=ioc_laithieu
POSTGRES_USER=ioc_admin
# Docker tự mã hóa mật khẩu khi tạo chuỗi kết nối, nên có thể dùng đầy đủ ký tự đặc biệt.
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Chỉ dùng khi chạy API trực tiếp ngoài Docker. Nếu mật khẩu có ký tự đặc biệt,
# hãy percent-encode phần tên đăng nhập và mật khẩu trong URL này.
DATABASE_URL=postgresql://ioc_admin:replace-with-a-random-database-password@localhost:5432/ioc_laithieu?schema=public
# Prisma Migrate dùng kết nối trực tiếp/session; local dùng cùng URL với DATABASE_URL.
DIRECT_URL=postgresql://ioc_admin:replace-with-a-random-database-password@localhost:5432/ioc_laithieu?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Khuyến nghị đặt chuỗi ngẫu nhiên khác JWT_SECRET (tối thiểu 32 ký tự).
# Để trống thì hệ thống dùng JWT_SECRET làm khóa HMAC cho mã khôi phục.
PASSWORD_RESET_PEPPER=
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Chỉ bật true một lần khi khởi tạo môi trường demo; production luôn giữ false.
RUN_DEMO_SEED=false
PORT=3000
# Chỉ dùng cho npm run dev; bản Docker dùng API cùng tên miền qua /api.
VITE_API_URL=http://localhost:3000/api

# SMTP dùng cho OTP quên mật khẩu và thông báo tiến độ phản ánh.
# Điền tài khoản SMTP tại SMTP_USER và mật khẩu/mật khẩu ứng dụng tại SMTP_PASS.
# Cổng 587 thường dùng SMTP_SECURE=false; cổng 465 dùng SMTP_SECURE=true.
# Với kết nối không secure, hệ thống mặc định bắt buộc nâng cấp STARTTLS và TLS >= 1.2.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Worker email tiến độ: lấy theo lô, thử lại tối đa và giữ dead-letter để đối soát.
MAIL_OUTBOX_POLL_MS=5000
MAIL_OUTBOX_BATCH_SIZE=10
MAIL_OUTBOX_MAX_ATTEMPTS=8
# Production phải dùng địa chỉ công khai hợp lệ, không được dùng localhost/127.0.0.1.
PUBLIC_APP_URL=http://localhost:8080

# ==== Lớp AI cục bộ (trích xuất chỉ tiêu từ văn bản) ====
# Ollama chạy trên máy host; trong Docker dùng host.docker.internal, chạy trực tiếp dùng 127.0.0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EXTRACT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT_MS=480000
OLLAMA_NUM_CTX=4096
# Chạy API ngoài Docker trên Windows cần trỏ tesseract và thư mục traineddata tiếng Việt.
# Trong Docker image đã cài sẵn Tesseract cùng dữ liệu vie + eng nên để trống hai đường dẫn.
TESSERACT_PATH=
TESSDATA_DIR=
TESSERACT_LANGS=vie+eng
# Worker trích xuất: chu kỳ quét, số lần thử lại, giới hạn trang OCR mỗi tài liệu.
EXTRACTION_POLL_MS=4000
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_MAX_OCR_PAGES=20
EXTRACTION_MAX_LLM_CHUNKS=40
# Chỉ bật khi cần chẩn đoán API mà không muốn worker lấy tác vụ nền.
DISABLE_EXTRACTION_WORKER=false
